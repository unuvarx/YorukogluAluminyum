@{
    ViewBag.Title = "Anasayfa";
    Layout = "_Layout";
}

<!-- Hero Section -->
<section id="hero" class="hero section dark-background">

    <!-- Video Arka Planı -->
    <video autoplay loop muted playsinline class="hero-video">
        <source src="~/uploads/template/img/hero-bg.mp4" type="video/mp4">
        Tarayıcınız video etiketini desteklemiyor.
    </video>


    <div class="container">
        <h2 data-aos="fade-up" data-aos-delay="100">Yörükoğlu Alüminyum Metal</h2>
        <p data-aos="fade-up" data-aos-delay="200">
            Dayanıklı ve estetik alüminyum & metal çözümlerimizle, sizlere en kaliteli hizmeti sunuyoruz.
            Demir kapı, korkuluk, balkon ve daha fazlası için bize ulaşın.
        </p>
        <div class="d-flex mt-4" data-aos="fade-up" data-aos-delay="300">
            <a href="/iletisim" class="btn-get-started">Bize Ulaşın</a>
        </div>
    </div>


</section><!-- /Hero Section -->


<!-- About Section -->
<section id="about" class="about section">
    <div class="container">
        <div class="row gy-4">
            <div class="col-lg-6 order-1 order-lg-2" data-aos="fade-up" data-aos-delay="100">
                <img src="~/uploads/template/img/about.jpg" class="img-fluid" alt="Yörükoğlu Alüminyum Metal">
            </div>
            <div class="col-lg-6 order-2 order-lg-1 content" data-aos="fade-up" data-aos-delay="200">
                <h3>Yörükoğlu Alüminyum Metal</h3>
                <p class="fst-italic">
                    Yılların verdiği deneyimle alüminyum ve metal sektöründe kaliteli ve dayanıklı çözümler sunuyoruz. Demir kapı, korkuluk, balkon korkuluğu ve daha birçok metal işçiliğinde uzman ekibimizle hizmetinizdeyiz.
                </p>
                <ul>
                    <li><i class="bi bi-check-circle"></i> <span>Özel tasarım demir kapı, ferforje korkuluk ve alüminyum doğrama çözümleri.</span></li>
                    <li><i class="bi bi-check-circle"></i> <span>Dayanıklı, estetik ve güvenli ürünlerle müşteri memnuniyeti garantisi.</span></li>
                    <li><i class="bi bi-check-circle"></i> <span>Profesyonel ekibimizle kaliteli işçilik ve zamanında teslimat.</span></li>
                </ul>
                <a href="#" class="read-more"><span>Daha Fazla Bilgi</span><i class="bi bi-arrow-right"></i></a>
            </div>
        </div>
    </div>
</section><!-- /About Section -->




<!-- Counts Section -->
<section id="counts" class="section counts light-background">
    <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row gy-4">
            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="500" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Mutlu Müşteri</p>
                </div>
            </div><!-- End Stats Item -->
            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="1000" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Tamamlanan Proje</p>
                </div>
            </div><!-- End Stats Item -->
            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="25" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Yıllık Tecrübe</p>
                </div>
            </div><!-- End Stats Item -->
            <div class="col-lg-3 col-md-6">
                <div class="stats-item text-center w-100 h-100">
                    <span data-purecounter-start="0" data-purecounter-end="30" data-purecounter-duration="1" class="purecounter"></span>
                    <p>Uzman Personel</p>
                </div>
            </div><!-- End Stats Item -->
        </div>
    </div>
</section><!-- /Counts Section -->



<!-- Why Us Section -->
<section id="why-us" class="section why-us">

    <div class="container">

        <div class="row gy-4">

            <div class="col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="why-box">
                    <h3>Neden Yörükoğlu Alüminyum Metal?</h3>
                    <p>
                        Yörükoğlu Alüminyum Metal olarak, kaliteli alüminyum ve metal ürünleriyle uzun yıllardır sanayi sektöründe hizmet vermekteyiz. Demir kapı, korkuluk, balkon gibi ürünlerimizle güvenliği ve estetiği ön planda tutuyoruz. Müşteri memnuniyetini her zaman önceliğimiz olarak kabul ediyoruz ve her projede en yüksek standartları sağlamak için çalışıyoruz.
                    </p>
                    <div class="text-center">
                        <a href="#" class="more-btn"><span>Detaylı Bilgi</span> <i class="bi bi-chevron-right"></i></a>
                    </div>
                </div>
            </div><!-- End Why Box -->

            <div class="col-lg-8 d-flex align-items-stretch">
                <div class="row gy-4" data-aos="fade-up" data-aos-delay="200">

                    <div class="col-xl-4">
                        <div class="icon-box d-flex flex-column justify-content-center align-items-center">
                            <i class="bi bi-clipboard-data"></i>
                            <h4>Dayanıklı ve Güvenilir Ürünler</h4>
                            <p>Alüminyum ve metal ürünlerimiz, yüksek kaliteli malzemeler kullanılarak üretilmektedir. Ürünlerimiz uzun ömürlüdür ve her türlü hava koşuluna dayanıklıdır.</p>
                        </div>
                    </div><!-- End Icon Box -->

                    <div class="col-xl-4" data-aos="fade-up" data-aos-delay="300">
                        <div class="icon-box d-flex flex-column justify-content-center align-items-center">
                            <i class="bi bi-gem"></i>
                            <h4>Estetik ve Fonksiyonel Tasarımlar</h4>
                            <p>Demir kapı, korkuluk ve balkon ürünlerimiz, estetik tasarımları ve işlevselliği ile her türlü yapı için mükemmel uyum sağlar.</p>
                        </div>
                    </div><!-- End Icon Box -->

                    <div class="col-xl-4" data-aos="fade-up" data-aos-delay="400">
                        <div class="icon-box d-flex flex-column justify-content-center align-items-center">
                            <i class="bi bi-inboxes"></i>
                            <h4>Zamanında ve Sorunsuz Teslimat</h4>
                            <p>Projelerinizi zamanında teslim etmek için titizlikle çalışıyoruz. Her aşamada müşteri memnuniyetini sağlamak için gerekli önlemleri alıyoruz.</p>
                        </div>
                    </div><!-- End Icon Box -->

                </div>
            </div>

        </div>

    </div>

</section><!-- /Why Us Section -->


<!-- Features Section -->

<section id="features" class="features section">
    <div class="container">
        <div class="row gy-4">

            <style>
                .features-item {
                    width: 100%;
                    height: 250px; /* Hepsi eşit yükseklikte */
                    padding: 20px;
                    text-align: center;
                    background: #f8f9fa;
                    border-radius: 10px;
                    display: flex;
                    flex-direction: column;
                    justify-content: center;
                    align-items: center;
                    transition: transform 0.3s ease-in-out;
                }

                .features-item:hover {
                    transform: scale(1.05);
                    background: #e9ecef;
                }

                .features-item i {
                    font-size: 2rem;
                    margin-bottom: 10px;
                }

                .features-item h3 {
                    font-size: 1.2rem;
                    font-weight: bold;
                    margin-bottom: 10px;
                }

                .features-item p {
                    font-size: 0.9rem;
                    color: #555;
                }
            </style>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                <div class="features-item">
                    <i class="bi bi-eye" style="color: #ffbb2c;"></i>
                    <h3>Dayanıklı Alüminyum Ürünler</h3>
                    <p>Alüminyum ürünlerimiz uzun ömürlü ve yüksek kalite standartlarına sahiptir.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                <div class="features-item">
                    <i class="bi bi-infinity" style="color: #5578ff;"></i>
                    <h3>Çeşitli Tasarım Seçenekleri</h3>
                    <p>Estetik ve fonksiyonelliği bir arada sunan özelleştirilebilir tasarımlar.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                <div class="features-item">
                    <i class="bi bi-mortarboard" style="color: #e80368;"></i>
                    <h3>Özelleştirilmiş Çözümler</h3>
                    <p>Müşterilerimize özel projeler geliştiriyoruz, her aşamada kaliteyi ön planda tutuyoruz.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="400">
                <div class="features-item">
                    <i class="bi bi-nut" style="color: #e361ff;"></i>
                    <h3>İnovasyon ve Teknoloji</h3>
                    <p>En yeni üretim teknolojileri ile kaliteli ve dayanıklı ürünler üretiyoruz.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="500">
                <div class="features-item">
                    <i class="bi bi-shuffle" style="color: #47aeff;"></i>
                    <h3>Zamanında Teslimat</h3>
                    <p>Projelerinizi en kısa sürede tamamlayıp, tam zamanında teslim ediyoruz.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="600">
                <div class="features-item">
                    <i class="bi bi-star" style="color: #ffa76e;"></i>
                    <h3>Üstün Müşteri Desteği</h3>
                    <p>7/24 müşteri desteğimizle her zaman yanınızdayız.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="700">
                <div class="features-item">
                    <i class="bi bi-x-diamond" style="color: #11dbcf;"></i>
                    <h3>Estetik ve Fonksiyonellik</h3>
                    <p>Görselliği ve dayanıklılığı bir arada sunan modern tasarımlar.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="800">
                <div class="features-item">
                    <i class="bi bi-camera-video" style="color: #4233ff;"></i>
                    <h3>Sektördeki Liderlik</h3>
                    <p>Uzun yıllara dayanan tecrübemizle sektörde fark yaratıyoruz.</p>
                </div>
            </div>

            <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="900">
                <div class="features-item">
                    <i class="bi bi-lightning-charge" style="color: #ff5733;"></i>
                    <h3>Hızlı ve Güvenilir Hizmet</h3>
                    <p>Hızlı üretim ve güvenilir teslimat süreçleri ile müşterilerimize en iyi hizmeti sunuyoruz.</p>
                </div>
            </div>

        </div>
    </div>
</section>
<!-- Features Section End -->


<!-- Courses Section -->
<section id="courses" class="courses section">

  <!-- Section Title -->
  <div class="container section-title" data-aos="fade-up">
    <h2>Ürünlerimiz</h2>
    <p>Popüler Ürünlerimiz</p>
  </div><!-- End Section Title -->

  <div class="container">

    <div class="row">

      <div class="col-lg-4 col-md-6 d-flex align-items-stretch" data-aos="zoom-in" data-aos-delay="100">
        <div class="course-item">
          <img src="~/uploads/template/img/course-1.jpg" class="img-fluid" alt="Demir Kapı">
          <div class="course-content">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <p class="category">Demir Kapı</p>
              <p class="price">₺5000</p>
            </div>

            <h3><a href="course-details.html">Demir Kapı Tasarımı</a></h3>
            <p class="description">Dayanıklı demir kapılarımız, estetik ve güvenliği bir arada sunuyor. Farklı tasarımlar ve özelliklerle her ihtiyaca uygun çözümler.</p>
            <div class="trainer d-flex justify-content-between align-items-center">
              <div class="trainer-profile d-flex align-items-center">
                <img src="~/uploads/template/img/trainers/trainer-1-2.jpg" class="img-fluid" alt="Yörükoğlu Metal">
                <a href="" class="trainer-link">Yörükoğlu Metal</a>
              </div>
              <div class="trainer-rank d-flex align-items-center">
                <i class="bi bi-person user-icon"></i>&nbsp;30
                &nbsp;&nbsp;
                <i class="bi bi-heart heart-icon"></i>&nbsp;45
              </div>
            </div>
          </div>
        </div>
      </div> <!-- End Course Item-->

      <div class="col-lg-4 col-md-6 d-flex align-items-stretch mt-4 mt-md-0" data-aos="zoom-in" data-aos-delay="200">
        <div class="course-item">
          <img src="~/uploads/template/img/course-2.jpg" class="img-fluid" alt="Korkuluk">
          <div class="course-content">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <p class="category">Korkuluk</p>
              <p class="price">₺3500</p>
            </div>

            <h3><a href="course-details.html">Metal Korkuluk Üretimi</a></h3>
            <p class="description">Güvenlik ve estetiği ön planda tutarak, her tür metal korkuluk ihtiyacınıza uygun çözümler sunuyoruz.</p>
            <div class="trainer d-flex justify-content-between align-items-center">
              <div class="trainer-profile d-flex align-items-center">
                <img src="~/uploads/template/img/trainers/trainer-2-2.jpg" class="img-fluid" alt="Yörükoğlu Metal">
                <a href="" class="trainer-link">Yörükoğlu Metal</a>
              </div>
              <div class="trainer-rank d-flex align-items-center">
                <i class="bi bi-person user-icon"></i>&nbsp;25
                &nbsp;&nbsp;
                <i class="bi bi-heart heart-icon"></i>&nbsp;50
              </div>
            </div>
          </div>
        </div>
      </div> <!-- End Course Item-->

      <div class="col-lg-4 col-md-6 d-flex align-items-stretch mt-4 mt-lg-0" data-aos="zoom-in" data-aos-delay="300">
        <div class="course-item">
          <img src="~/uploads/template/img/course-3.jpg" class="img-fluid" alt="Alüminyum Ürünler">
          <div class="course-content">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <p class="category">Alüminyum</p>
              <p class="price">₺4200</p>
            </div>

            <h3><a href="course-details.html">Alüminyum Kapı ve Pencere</a></h3>
            <p class="description">Yüksek kaliteli alüminyum ile üretilen kapı ve pencere çözümleri, dayanıklılık ve enerji verimliliği sağlar.</p>
            <div class="trainer d-flex justify-content-between align-items-center">
              <div class="trainer-profile d-flex align-items-center">
                <img src="~/uploads/template/img/trainers/trainer-3-2.jpg" class="img-fluid" alt="Yörükoğlu Metal">
                <a href="" class="trainer-link">Yörükoğlu Metal</a>
              </div>
              <div class="trainer-rank d-flex align-items-center">
                <i class="bi bi-person user-icon"></i>&nbsp;20
                &nbsp;&nbsp;
                <i class="bi bi-heart heart-icon"></i>&nbsp;40
              </div>
            </div>
          </div>
        </div>
      </div> <!-- End Course Item-->

    </div>

  </div>

</section><!-- /Courses Section -->



