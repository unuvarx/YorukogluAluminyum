@{
  ViewBag.Title = "Hizmetlerimiz";
  Layout = "_Layout";
}

<!-- Page Title -->
<div class="page-title" data-aos="fade">
  <div class="heading">
    <div class="container">
      <div class="row d-flex justify-content-center text-center">
        <div class="col-lg-8">
          <h1>Hizmetlerimiz<br></h1>
          <p class="mb-0">Yörükoğlu Alüminyum olarak, alüminyum ve metal işleme sektöründe kaliteli ve estetik çözümler sunuyoruz. Modern tasarımlar ve dayanıklı malzemelerle, her ihtiyaca uygun alüminyum ürünler üretiyoruz.</p>
        </div>
      </div>
    </div>
  </div>
  <nav class="breadcrumbs">
    <div class="container">
      <ol>
        <li><a href="/anasayfa">Anasayfa</a></li>
        <li class="current"> Hizmetlerimiz<br></li>
      </ol>
    </div>
  </nav>
</div><!-- End Page Title -->

<!-- Services Section -->
<section id="events" class="events section">

  <div class="container" data-aos="fade-up">

    <div class="row">
      <!-- Service 1: Pergola -->
      <div class="col-md-4 d-flex align-items-stretch">
        <div class="card">
          <div class="card-img">
            <img src="~/uploads/template/img/pergola.jpg" alt="Pergola">
          </div>
          <div class="card-body">
            <h5 class="card-title"><a href="">Pergola</a></h5>
            <p class="card-text">Şık ve modern pergola sistemleri ile dış mekanlarınızı estetik ve fonksiyonel hale getiriyoruz.</p>
          </div>
        </div>
      </div>

      <!-- Service 2: Giyotin Cam Balkon -->
      <div class="col-md-4 d-flex align-items-stretch">
        <div class="card">
          <div class="card-img">
            <img src="~/uploads/template/img/giyotin.jpg" alt="Giyotin Cam Balkon">
          </div>
          <div class="card-body">
            <h5 class="card-title"><a href="">Giyotin Cam Balkon</a></h5>
            <p class="card-text">Modern yaşam alanları için pratik ve şık giyotin cam balkon çözümleri sunuyoruz.</p>
          </div>
        </div>
      </div>

      <!-- Service 3: Fotoselli Kapı -->
      <div class="col-md-4 d-flex align-items-stretch">
        <div class="card">
          <div class="card-img">
            <img src="~/uploads/template/img/kapi.jpg" alt="Fotoselli Kapı">
          </div>
          <div class="card-body">
            <h5 class="card-title"><a href="">Fotoselli Kapı</a></h5>
            <p class="card-text">Gelişmiş fotoselli kapı sistemleri ile her girişte pratik ve güvenli kullanım sağlıyoruz.</p>
          </div>
        </div>
      </div>

      <!-- Service 4: Isıcamlı ve Normal Cambalkon -->
      <div class="col-md-4 d-flex align-items-stretch">
        <div class="card">
          <div class="card-img">
            <img src="~/uploads/template/img/cambalkon.jpg" alt="Isıcamlı ve Normal Cambalkon">
          </div>
          <div class="card-body">
            <h5 class="card-title"><a href="">Isıcamlı ve Normal Cambalkon</a></h5>
            <p class="card-text">Isıcamlı ve normal cambalkon sistemleri ile hem estetik hem de enerji verimliliği sağlıyoruz.</p>
          </div>
        </div>
      </div>

      <!-- Service 5: Sürme Seri Çeşitleri -->
      <div class="col-md-4 d-flex align-items-stretch">
        <div class="card">
          <div class="card-img">
            <img src="~/uploads/template/img/surme.jpg" alt="Sürme Seri Çeşitleri">
          </div>
          <div class="card-body">
            <h5 class="card-title"><a href="">Sürme Seri Çeşitleri</a></h5>
            <p class="card-text">Sürme sistemlerindeki geniş çeşitlilikle ihtiyacınıza uygun en iyi çözümü sunuyoruz.</p>
          </div>
        </div>
      </div>

      <!-- Service 6: Isı Yalıtımlı ve Yalıtımsız Doğrama Çeşitleri -->
      <div class="col-md-4 d-flex align-items-stretch">
        <div class="card">
          <div class="card-img">
            <img src="~/uploads/template/img/dograma.jpg" alt="Isı Yalıtımlı ve Yalıtımsız Doğrama Çeşitleri">
          </div>
          <div class="card-body">
            <h5 class="card-title"><a href="">Isı Yalıtımlı ve Yalıtımsız Doğrama Çeşitleri</a></h5>
            <p class="card-text">Isı yalıtımlı ve yalıtımsız doğrama seçeneklerimizle enerji verimliliği sağlıyoruz.</p>
          </div>
        </div>
      </div>

      <!-- Service 7: Ofis Bölmeleri -->
      <div class="col-md-4 d-flex align-items-stretch">
        <div class="card">
          <div class="card-img">
            <img src="~/uploads/template/img/office.jpg" alt="Ofis Bölmeleri">
          </div>
          <div class="card-body">
            <h5 class="card-title"><a href="">Ofis Bölmeleri</a></h5>
            <p class="card-text">Modern ofis alanları için şık ve fonksiyonel ofis bölmeleri çözümleri sunuyoruz.</p>
          </div>
        </div>
      </div>

      <!-- Service 8: Kışbahçesi -->
      <div class="col-md-4 d-flex align-items-stretch">
        <div class="card">
          <div class="card-img">
            <img src="~/uploads/template/img/kis.jpg" alt="Kışbahçesi">
          </div>
          <div class="card-body">
            <h5 class="card-title"><a href="">Kışbahçesi</a></h5>
            <p class="card-text">Kış bahçesi sistemleri ile evinizi dört mevsim kullanabileceğiniz bir yaşam alanına dönüştürün.</p>
          </div>
        </div>
      </div>

      <!-- Service 9: Veranda -->
      <div class="col-md-4 d-flex align-items-stretch">
        <div class="card">
          <div class="card-img">
            <img src="~/uploads/template/img/veranda.jpg" alt="Veranda">
          </div>
          <div class="card-body">
            <h5 class="card-title"><a href="">Veranda</a></h5>
            <p class="card-text">Şık veranda çözümleri ile dış mekanlarınızı estetik ve fonksiyonel hale getiriyoruz.</p>
          </div>
        </div>
      </div>

      <!-- Service 10: Kompozit Cephe Sistemleri -->
      <div class="col-md-4 d-flex align-items-stretch">
        <div class="card">
          <div class="card-img">
            <img src="~/uploads/template/img/kompozit.jpg" alt="Kompozit Cephe Sistemleri">
          </div>
          <div class="card-body">
            <h5 class="card-title"><a href="">Kompozit Cephe Sistemleri</a></h5>
            <p class="card-text">Kompozit cephe sistemleri ile binalarınıza modern ve şık bir görünüm kazandırıyoruz.</p>
          </div>
        </div>
      </div>
    </div>

  </div>

</section><!-- /Services Section -->
